# Lapwing coach server (coach/). Copy to .env and fill in; .env is never committed.
# The key stays on the server: the browser only talks to /api/coach/.

# Anthropic API key (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=

# Keys not scoped to a workspace (user keys, sk-ant-usr-…) also need the
# workspace ID (wrkspc_…, from the Console's Workspaces page):
# ANTHROPIC_WORKSPACE_ID=

# Or, instead of the key, a token sent as "Authorization: Bearer":
# ANTHROPIC_AUTH_TOKEN=

# Optional:
# COACH_MODEL=claude-opus-5-5
# COACH_EFFORT=medium          # low | medium | high | xhigh | max
# COACH_MAX_TOKENS=64000
# COACH_RATE_PER_MIN=20        # questions per minute, all devices together
# COACH_FALLBACKS=off          # disable the fallback model on refusals
# COACH_PORT=8001
